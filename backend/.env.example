# Local backend port. A public HTTPS address is only needed later when Android clients test against it.
PORT=8080
NODE_ENV=development

# Directly wires this backend to the user's existing Firebase project.
# Preferred local setup: authenticate with `gcloud auth application-default login`
# and set GOOGLE_CLOUD_PROJECT. This does not require a downloaded private key.
GOOGLE_CLOUD_PROJECT=school-notics

# Optional alternative for a CI server or a host that cannot use Application Default Credentials.
# Never commit this value, paste it into chat, or put it in an APK.
FIREBASE_SERVICE_ACCOUNT_JSON=
