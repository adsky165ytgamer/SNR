rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    match /receivers/{receiverId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /notices/{noticeId} {
        allow read: if signedIn()
          && get(/databases/$(database)/documents/receivers/$(receiverId)).data.ownerUid == request.auth.uid;
        allow create: if signedIn()
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.receiverId == receiverId;
        allow update, delete: if false;
      }
    }
  }
}
